# Optional override for Cloudflare Worker R2 API endpoint.
# Defaults to https://nso-mods-api.nsomatrix.workers.dev
NEXT_PUBLIC_MODS_API_URL=https://nso-mods-api.nsomatrix.workers.dev

# -----------------------------------------------------------------------------
# FIREBASE AUTHENTICATION (Client SDK)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps (Web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -----------------------------------------------------------------------------
# FIREBASE ADMIN SDK (Server-Side Session Cookies & Verification)
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Alternative: entire service account JSON string if preferred
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
